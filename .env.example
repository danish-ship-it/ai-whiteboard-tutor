# Claude API (https://console.anthropic.com) — server-side only
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional: override the model (default claude-opus-5-5)
ANTHROPIC_MODEL=

# ElevenLabs (https://elevenlabs.io) — server-side only
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-voice-id
# Optional: default eleven_multilingual_v2
ELEVENLABS_MODEL_ID=

# Random secret used to sign lesson manifests (generate: openssl rand -hex 32)
LESSON_SIGNING_SECRET=change-me
# Optional: Claude effort for lesson generation: low (default, fastest) | medium | high
LESSON_EFFORT=

# Optional: step pictures and clips for new lessons. BBANANA is used when both are set.
# BBANANA (https://www.bbanana.ai): about 1 credit a picture, permanent links
BBANANA_API_KEY=
# Runway (https://dev.runwayml.com)
RUNWAYML_API_SECRET=
